source "https://rubygems.org"

# Сайт собирается на GitHub Pages через actions/jekyll-build-pages,
# поэтому локально держим тот же набор гемов, что и там.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
